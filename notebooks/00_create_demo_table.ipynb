# COMMAND ----------
import os
from pyspark.sql import SparkSession

spark = SparkSession.builder.getOrCreate()

# Get catalog/schema from environment variables (set in databricks.yml)
catalog = os.getenv("DATABRICKS_CATALOG", "hive_metastore")
schema = os.getenv("DATABRICKS_SCHEMA", "default")

# Enforce session context
spark.sql(f"USE CATALOG {catalog}")
spark.sql(f"USE SCHEMA {schema}")

print("📌 Active catalog:", spark.catalog.currentCatalog())
print("📌 Active schema:", spark.catalog.currentDatabase())

# Create demo_sales table
data = [(1, "Apple", 10), (2, "Banana", 20), (3, "Orange", 30)]
columns = ["id", "product", "amount"]

df = spark.createDataFrame(data, columns)
df.write.mode("overwrite").saveAsTable("demo_sales")

print("✅ Table demo_sales created")
