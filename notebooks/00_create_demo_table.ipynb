# Databricks notebook source
import os
from pyspark.sql import SparkSession

# Get Spark session
spark = SparkSession.builder.getOrCreate()

# Get catalog and schema from environment variables (passed by Databricks Bundle)
# If not set, defaults to kroger_poc.default
catalog = os.getenv("DATABRICKS_BUNDLE_VAR_catalog", "kroger_poc")
schema = os.getenv("DATABRICKS_BUNDLE_VAR_schema", "default")

# Define target table
table_name = f"{catalog}.{schema}.demo_sales"

print(f"📂 Using catalog: {catalog}, schema: {schema}")

# Create schema if it doesn't exist
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {catalog}.{schema}")

# Create or replace demo table
print(f"🛠 Creating table: {table_name}")
spark.sql(f"""
CREATE OR REPLACE TABLE {table_name} AS
SELECT 1 AS id, 'productA' AS product, 100 AS amount
UNION ALL
SELECT 2 AS id, 'productB' AS product, 200 AS amount
""")

print(f"✅ Table {table_name} created successfully!")
