# COMMAND ----------
import os
from pyspark.sql import SparkSession

spark = SparkSession.builder.getOrCreate()

catalog = os.getenv("DATABRICKS_CATALOG", "hive_metastore")
schema = os.getenv("DATABRICKS_SCHEMA", "default")

spark.sql(f"USE CATALOG {catalog}")
spark.sql(f"USE SCHEMA {schema}")

print("📌 Active catalog:", spark.catalog.currentCatalog())
print("📌 Active schema:", spark.catalog.currentDatabase())

# Load demo_sales and create an ETL output
df = spark.table("demo_sales")
df_transformed = df.withColumnRenamed("amount", "amount_usd")

df_transformed.write.mode("overwrite").saveAsTable("etl_demo_output")

print("✅ Table etl_demo_output created")
